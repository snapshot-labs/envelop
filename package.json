{
  "name": "envelop",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "nodemon src/index.ts -e js,ts,hbs,json",
    "start": "node dist/src/index.js",
    "start:test": "dotenv -e test/.env.test yarn dev",
    "test": "PORT=3030 start-server-and-test 'yarn start:test' 3030 'dotenv -e test/.env.test jest --runInBand'",
    "test:unit": "dotenv -e test/.env.test jest test/unit/",
    "test:e2e": "PORT=3030 start-server-and-test 'yarn start:test' 3030 'dotenv -e test/.env.test jest --runInBand --collectCoverage=false test/e2e/'",
    "db:generate": "drizzle-kit generate"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "prettier": "@snapshot-labs/prettier-config",
  "dependencies": {
    "@apollo/client": "^3.7.17",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/address": "^5.7.0",
    "@ethersproject/wallet": "^5.7.0",
    "@sendgrid/mail": "^7.7.0",
    "@snapshot-labs/snapshot-metrics": "^2.0.0",
    "@snapshot-labs/snapshot-sentry": "^3.1.0",
    "bull": "^4.10.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.9",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-prom-bundle": "^6.6.0",
    "graphql": "^16.8.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.0.0",
    "juice": "^9.1.0",
    "lodash.chunk": "^4.2.0",
    "marked": "< 5",
    "pg": "^8.11.3",
    "prom-client": "^14.2.0",
    "remove-markdown": "^0.5.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@snapshot-labs/eslint-config": "^0.1.1",
    "@snapshot-labs/prettier-config": "^0.1.0",
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/lodash.chunk": "^4.2.7",
    "@types/marked": "^4.3.0",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.10.9",
    "@types/remove-markdown": "^0.3.1",
    "@types/supertest": "^2.0.12",
    "dotenv-cli": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "jest-environment-node-single-context": "^29.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "sass": "^1.66.1",
    "start-server-and-test": "^2.0.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6"
  }
}
